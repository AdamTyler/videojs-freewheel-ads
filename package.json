{
  "name": "videojs-freewheel-ads",
  "version": "0.1.7",
  "description": "VideoJS plugin for ads through the Freewheel network",
  "main": "dist/videojs-freewheel-ads.cjs.js",
  "module": "dist/videojs-freewheel-ads.es.js",
  "browser": "dist/videojs-freewheel-ads.js",
  "generator-videojs-plugin": {
    "version": "9.0.0"
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "npm-run-all -p build:*",
    "build:css": "postcss -o dist/videojs-freewheel-ads.css --config scripts/postcss.config.js src/plugin.css",
    "build:js": "rollup -c scripts/rollup.config.js",
    "build:lang": "vjslang --dir dist/lang",
    "clean": "shx rm -rf ./dist ./test/dist",
    "postclean": "shx mkdir -p ./dist ./test/dist",
    "docs": "npm-run-all docs:*",
    "docs:api": "jsdoc src -g plugins/markdown -r -d docs/api",
    "docs:toc": "doctoc --notitle README.md",
    "lint": "vjsstandard",
    "server": "karma start scripts/karma.conf.js --singleRun=false --auto-watch",
    "start": "npm-run-all -p server watch",
    "pretest": "npm-run-all lint build",
    "test": "npm-run-all test:*",
    "posttest": "shx cat test/dist/coverage/text.txt",
    "test:unit": "karma start scripts/karma.conf.js",
    "test:verify": "vjsverify --verbose --skip-es-check",
    "update-changelog": "conventional-changelog -p videojs -i CHANGELOG.md -s",
    "preversion": "npm test",
    "version": "is-prerelease || npm run update-changelog && git add CHANGELOG.md",
    "watch": "npm-run-all -p watch:*",
    "watch:css": "npm run build:css -- -w",
    "watch:js": "npm run build:js -- -w",
    "prepublishOnly": "npm-run-all build test:verify"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "keywords": [
    "ads",
    "freewheel",
    "videojs",
    "videojs-plugin"
  ],
  "author": "Adam Tyler <adam.tyler@utexas.edu>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamTyler/videojs-freewheel-ads.git"
  },
  "vjsstandard": {
    "ignore": [
      "dist",
      "docs",
      "test/dist"
    ]
  },
  "files": [
    "CONTRIBUTING.md",
    "dist/",
    "docs/",
    "index.html",
    "scripts/",
    "src/",
    "test/"
  ],
  "peerDependencies": {
    "video.js": "^8.11.6",
    "videojs-contrib-ads": "^7.5.2"
  },
  "devDependencies": {
    "@videojs/generator-helpers": "~3.2.0",
    "jsdoc": "^4.0.4",
    "karma": "^6.4.4",
    "postcss": "^8.4.24",
    "postcss-cli": "^8.3.1",
    "rollup": "^2.79.2",
    "sinon": "^22.0.0",
    "video.js": "^8.11.6",
    "videojs-contrib-ads": "^7.5.2",
    "videojs-generate-karma-config": "~8.1.0",
    "videojs-generate-postcss-config": "~3.0.1",
    "videojs-generate-rollup-config": "~7.0.2",
    "videojs-generator-verify": "~4.1.3",
    "videojs-languages": "^2.0.0",
    "videojs-standard": "^9.1.0"
  }
}
